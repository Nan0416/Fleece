{
  "name": "fleece",
  "version": "1.0.0",
  "private": true,
  "description": "A trading system on top of Alpaca: virtual accounts, order tracking and position accounting.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @fleece/utilities && npm run build -w @fleece/models && npm run build -w @fleece/client -w @fleece/marketdata && npm run build -w @fleece/broker && npm run build -w @fleece/service",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "start": "npm run build && node packages/service/dist/api/main.js",
    "start:tracking-service": "npm run build && node packages/service/dist/tracking/main.js",
    "corporate-actions": "npm run build && node packages/service/dist/corporate-actions/main.js",
    "build:all": "tsc -b",
    "test": "jest --config jest.config.js",
    "test:ci": "jest --config jest.config.js --ci --no-cache --json --outputFile=jest-results.json",
    "test:coverage": "jest --config jest.coverage.config.js --coverage",
    "test:live": "jest --config jest.live.config.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:lint": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nan0416/Fleece.git"
  },
  "bugs": {
    "url": "https://github.com/Nan0416/Fleece/issues"
  },
  "homepage": "https://github.com/Nan0416/Fleece#readme",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.18.0",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
