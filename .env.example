# Copy to .env and fill in. Nothing here is read automatically — export it, or use a
# tool like direnv. Values shown are the defaults where there is one.

# ---- shared by all three processes ----
FLEECE_STAGE=beta
FLEECE_DATABASE_URL=postgres://localhost:5432/fleece_beta
FLEECE_LOG_LEVEL=info

# ---- the API (fleece serve) ----
FLEECE_PORT=3100
FLEECE_HOST=127.0.0.1
# Unset means no authentication, and the service warns about it on every start.
# FLEECE_TOKEN=
# Setting this replaces the default of "*" rather than adding to it.
# FLEECE_CORS_ORIGINS=http://localhost:5173

# ---- the injector (fleece injector start) ----
# Without an account id the injector runs and does nothing, and warns.
# FLEECE_ALPACA_ACCOUNT_ID=
# FLEECE_ALPACA_KEY=
# FLEECE_ALPACA_SECRET=
FLEECE_ALPACA_LIVE=false
# A second broker account, and so on. The first uses the unsuffixed names above.
# FLEECE_ALPACA_2_ACCOUNT_ID=
# FLEECE_ALPACA_2_KEY=
# FLEECE_ALPACA_2_SECRET=
# FLEECE_ALPACA_2_LIVE=true

# Where a fill lands when no strategy claims it. Both accounts must exist.
FLEECE_DEFAULT_PAPER_ACCOUNT_ID=0000000001
FLEECE_DEFAULT_LIVE_ACCOUNT_ID=0000000002
FLEECE_UNRESOLVED_ORDER_TIMEOUT_MS=60000

# ---- the dividend job (fleece corporate-actions run) ----
# FLEECE_POLYGON_API_KEY=

# ---- tests ----
# A throwaway database; every table is truncated between tests.
# FLEECE_TEST_DATABASE_URL=postgres://localhost:5432/fleece_test
