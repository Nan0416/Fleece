{
  "name": "@fleece/playground",
  "version": "1.0.0",
  "private": true,
  "description": "Throwaway experiment scripts. Not part of the product build and nothing imports it.",
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "order-events": "npm run build && node dist/order-events.js",
    "cancel-order": "npm run build && node dist/cancel-order.js",
    "list-positions": "npm run build && node dist/list-positions.js",
    "position-monitor": "npm run build && node dist/monitor/position/main.js",
    "option-chain": "npm run build && node dist/option-chain.js",
    "option-availability": "npm run build && node dist/option-availability.js",
    "implied-volatility-history": "npm run build && node dist/implied-volatility-history.js",
    "constant-maturity-volatility": "npm run build && node dist/constant-maturity-volatility.js",
    "option-quote-spread": "npm run build && node dist/option-quote-spread.js",
    "volatility-premium": "npm run build && node dist/volatility-premium.js",
    "watchlist": "npm run build && node dist/watchlist.js",
    "sell-put": "npm run build && node dist/research/sell-put.js"
  },
  "dependencies": {
    "@fleece/broker": "1.0.0",
    "@fleece/marketdata": "1.0.0",
    "@fleece/utilities": "1.0.0",
    "discord.js": "^14.27.0",
    "nanoid": "^3.3.11",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "dotenv": "^17.4.2",
    "typescript": "^5.7.3"
  },
  "license": "MIT"
}
